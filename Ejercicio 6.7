def encabezado(titulo, subtitulo):
    return widgets.HTML(
        "<div style='background:#1a73e8;color:white;padding:10px 14px'>"
        f"<b style='font-size:16px'>{html.escape(titulo)}</b><br>"
        f"<span style='font-size:12px'>{html.escape(subtitulo)}</span></div>")


def mensajes_html(mensajes):
    """Lista de (tipo, texto) -> HTML. tipo: 'ok' verde, 'error' rojo, 'info' azul."""
    colores = {"ok": ("#e6f4ea", "#137333"), "error": ("#fce8e6", "#c5221f"),
               "info": ("#e8f0fe", "#1967d2")}
    filas = ""
    for tipo, texto in mensajes:
        fondo, letra = colores[tipo]
        filas += (f"<div style='background:{fondo};color:{letra};padding:4px 8px;margin:2px 0;"
                  f"font-family:monospace;white-space:pre-wrap'>{html.escape(str(texto))}</div>")
    return filas


def ventana(*hijos):
    return widgets.VBox(list(hijos), layout=widgets.Layout(
        border="1px solid #9aa0a6", padding="0 0 10px 0", width="620px"))


def fila(*hijos):
    return widgets.HBox(list(hijos), layout=widgets.Layout(padding="4px 12px"))

