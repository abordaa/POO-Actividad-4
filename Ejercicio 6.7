class Programador:
    """Integrante de un equipo de la maratón de programación."""

    def __init__(self, nombre: str, apellidos: str):
        self.__nombre = nombre
        self.__apellidos = apellidos

    @property
    def nombre(self):
        return self.__nombre

    @property
    def apellidos(self):
        return self.__apellidos

    def __str__(self):
        return f"{self.__nombre} {self.__apellidos}"


class EquipoMaratonProgramacion:
    """Equipo que participa en una maratón de programación.
    Debe tener mínimo 2 y máximo 3 programadores."""

    MINIMO = 2
    MAXIMO = 3

    def __init__(self, nombre_equipo: str, universidad: str, lenguaje_programacion: str):
        self.__nombre_equipo = nombre_equipo
        self.__universidad = universidad
        self.__lenguaje_programacion = lenguaje_programacion
        self.__programadores = []          
        self.__tamano_equipo = 0           

    def esta_lleno(self) -> bool:
        """Determina si el equipo ya tiene el máximo de programadores (3)."""
        return self.__tamano_equipo == EquipoMaratonProgramacion.MAXIMO

    def esta_completo(self) -> bool:
        """Determina si el equipo tiene el mínimo para competir (2 o más)."""
        return self.__tamano_equipo >= EquipoMaratonProgramacion.MINIMO

    def anadir(self, programador: Programador):
        """Añade un programador. Si el equipo está lleno lanza una excepción."""
        if self.esta_lleno():
            raise Exception("El equipo está completo. No se pudo agregar programador.")
        self.__programadores.append(programador)
        self.__tamano_equipo += 1

    @staticmethod
    def validar_campo(campo: str):
        """Valida que el campo sea solo texto (sin dígitos) y que tenga
        menos de 20 caracteres. Si no cumple, lanza una excepción."""
        if campo.strip() == "":
            raise Exception("El campo no puede estar vacío.")
        for caracter in campo:
            if caracter.isdigit():
                raise Exception("El nombre no puede tener dígitos.")
        if len(campo) >= 20:
            raise Exception("La longitud debe ser menor a 20 caracteres.")

    @property
    def programadores(self):
        return list(self.__programadores)

    def __str__(self):
        integrantes = "\n".join(f"  {i}. {p}" for i, p in enumerate(self.__programadores, 1))
        return (f"Equipo: {self.__nombre_equipo} | Universidad: {self.__universidad} | "
                f"Lenguaje: {self.__lenguaje_programacion}\n"
                f"Integrantes ({self.__tamano_equipo}/{EquipoMaratonProgramacion.MAXIMO}):\n"
                f"{integrantes}")

    @staticmethod
    def main():
        """Crea un equipo con datos ingresados por teclado y registra tres
        integrantes validando sus nombres y apellidos."""
        nombre = input("Nombre del equipo = ")
        universidad = input("Universidad = ")
        lenguaje = input("Lenguaje de programación = ")
        equipo = EquipoMaratonProgramacion(nombre, universidad, lenguaje)
        print("Datos de los integrantes del equipo")
        while not equipo.esta_lleno():
            try:
                nombre_p = input("Nombre del integrante = ")
                EquipoMaratonProgramacion.validar_campo(nombre_p)
                apellidos_p = input("Apellidos del integrante = ")
                EquipoMaratonProgramacion.validar_campo(apellidos_p)
                equipo.anadir(Programador(nombre_p, apellidos_p))
            except Exception as ex:
                print(f"Excepción: {ex} Ingrese de nuevo el integrante.")
        print(equipo)
        return equipo

