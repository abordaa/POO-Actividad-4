class InterfazEquipoMaraton:
    """Formulario para crear un equipo y agregar programadores validando los campos."""

    def __init__(self):
        self.equipo = None
        self.txt_equipo = widgets.Text(description="Equipo:", placeholder="Ej: EquipoUNAL")
        self.txt_universidad = widgets.Text(description="Universidad:", placeholder="Ej: Nacional")
        self.txt_lenguaje = widgets.Text(value="Python", description="Lenguaje:")
        self.btn_crear = widgets.Button(description="Crear equipo", button_style="primary",
                                        icon="users")
        self.txt_nombre = widgets.Text(description="Nombre:")
        self.txt_apellidos = widgets.Text(description="Apellidos:")
        self.btn_anadir = widgets.Button(description="Añadir programador",
                                         button_style="success", icon="plus",
                                         layout=widgets.Layout(width="200px"))
        self.lbl_estado = widgets.HTML()
        self.lbl_salida = widgets.HTML()
        self.btn_crear.on_click(self.crear_equipo)
        self.btn_anadir.on_click(self.anadir_programador)

    def crear_equipo(self, boton=None):
        self.equipo = EquipoMaratonProgramacion(self.txt_equipo.value,
                                                self.txt_universidad.value,
                                                self.txt_lenguaje.value)
        self.lbl_salida.value = mensajes_html([("ok", "Equipo creado. Agregue de 2 a 3 programadores.")])
        self.actualizar_estado()

    def anadir_programador(self, boton=None):
        if self.equipo is None:
            self.lbl_salida.value = mensajes_html([("error", "Primero cree el equipo.")])
            return
        try:
            EquipoMaratonProgramacion.validar_campo(self.txt_nombre.value)
            EquipoMaratonProgramacion.validar_campo(self.txt_apellidos.value)
            self.equipo.anadir(Programador(self.txt_nombre.value, self.txt_apellidos.value))
            mensaje = ("ok", f"Programador agregado: {self.txt_nombre.value} {self.txt_apellidos.value}")
            self.txt_nombre.value = ""
            self.txt_apellidos.value = ""
        except Exception as ex:
            mensaje = ("error", f"Excepción: {ex}")
        self.lbl_salida.value = mensajes_html([mensaje])
        self.actualizar_estado()

    def actualizar_estado(self):
        estado = "Puede competir" if self.equipo.esta_completo() else "Faltan integrantes"
        if self.equipo.esta_lleno():
            estado = "Equipo lleno"
        self.lbl_estado.value = mensajes_html([("info", f"{self.equipo}\nEstado: {estado}")])

    def mostrar(self):
        display(ventana(
            encabezado("Ejercicio 6.7 - Maratón de programación", "Validación de campos con excepciones"),
            fila(widgets.HTML("<b>Datos del equipo</b>")),
            fila(self.txt_equipo, self.txt_universidad), fila(self.txt_lenguaje, self.btn_crear),
            fila(widgets.HTML("<b>Datos del programador</b>")),
            fila(self.txt_nombre, self.txt_apellidos), fila(self.btn_anadir),
            fila(self.lbl_salida), fila(self.lbl_estado)))


gui_67 = InterfazEquipoMaraton()
gui_67.mostrar()
