import io


class LeerArchivo:
    """Lee los datos de un archivo de texto (.txt) usando un flujo de bytes.
    Equivalencias con Java:
      FileInputStream   -> io.FileIO         (flujo de bytes del archivo)
      BufferedReader    -> io.BufferedReader (búfer para lectura eficiente)
      InputStreamReader -> io.TextIOWrapper  (convierte bytes en caracteres Unicode
                                              y ofrece readline())"""

    def __init__(self, nombre_archivo: str = "prueba.txt"):
        self.nombre_archivo = nombre_archivo

    def leer(self) -> list:
        """Devuelve la lista de líneas del archivo. Puede lanzar OSError
        (equivalente a IOException) si el archivo no se puede leer."""
        lineas = []
        archivo = io.FileIO(self.nombre_archivo, "r")          
        filtro = io.BufferedReader(archivo)                     
        conversor = io.TextIOWrapper(filtro, encoding="utf-8")  
        try:
            linea = conversor.readline()
            while linea != "":                    
                lineas.append(linea.rstrip("\n"))
                linea = conversor.readline()      
        finally:
            conversor.close()                     
        return lineas

    def mostrar_contenido(self):
        """Muestra en pantalla el contenido del archivo o un mensaje de error."""
        try:
            for linea in self.leer():
                print(linea)
        except OSError:
            print("No se pudo leer el archivo.")
        except UnicodeDecodeError:
            print("El archivo no es un archivo de texto válido.")

    @staticmethod
    def main():
        LeerArchivo("prueba.txt").mostrar_contenido()

LeerArchivo.main()

LeerArchivo("no_existe.txt").mostrar_contenido()

class InterfazLeerArchivo:
    """Ventana para escribir el nombre de un archivo y ver su contenido."""

    def __init__(self):
        self.txt_archivo = widgets.Text(value="prueba.txt", description="Archivo:")
        self.btn_leer = widgets.Button(description="Leer archivo", button_style="primary",
                                       icon="folder-open")
        self.txt_contenido = widgets.Textarea(
            value="", layout=widgets.Layout(width="580px", height="150px"))
        self.lbl_estado = widgets.HTML()
        self.btn_leer.on_click(self.leer)

    def leer(self, boton=None):
        lector = LeerArchivo(self.txt_archivo.value)
        try:
            lineas = lector.leer()
            self.txt_contenido.value = "\n".join(f"{i:>2} | {l}" for i, l in enumerate(lineas, 1))
            self.lbl_estado.value = mensajes_html(
                [("ok", f"Se leyeron {len(lineas)} líneas de '{self.txt_archivo.value}'.")])
        except OSError:
            self.txt_contenido.value = ""
            self.lbl_estado.value = mensajes_html([("error", "No se pudo leer el archivo.")])
        except UnicodeDecodeError:
            self.txt_contenido.value = ""
            self.lbl_estado.value = mensajes_html([("error", "El archivo no es de texto.")])

    def mostrar(self):
        display(ventana(
            encabezado("Ejercicio 6.8 - Lector de archivos", "Lectura de un archivo de texto con flujo de bytes"),
            fila(self.txt_archivo, self.btn_leer), fila(self.lbl_estado),
            fila(self.txt_contenido)))


gui_68 = InterfazLeerArchivo()
gui_68.mostrar()
